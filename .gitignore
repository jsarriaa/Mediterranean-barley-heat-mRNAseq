# Large local inputs (checksums tracked in data/input/MD5SUMS and references/MD5SUMS)
data/input/kallisto.merged.gene_counts.HC.tsv
data/input/kallisto.merged.gene_counts.LC.tsv
data/input/kallisto.E.gene_counts.HC.tsv
data/input/kallisto.E.gene_counts.LC.tsv
references/MorexV3_tx2gene.tsv
references/MorexV3_gene_confidence.tsv

# Upstream outputs: only the small files that document each library are
# tracked (fastp JSON reports and logs; kallisto run info, log and abundance.h5).
# FastQC reports, fastp HTML and kallisto abundance.tsv stay local.
results/upstream/**
!results/upstream/**/
!results/upstream/fastp/*.fastp.json
!results/upstream/fastp/log/*
!results/upstream/kallisto/*/run_info.json
!results/upstream/kallisto/*/kallisto_quant.log
!results/upstream/kallisto/*/abundance.h5

